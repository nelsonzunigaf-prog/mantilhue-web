---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandCard from '../components/BrandCard.astro';
import { getCollection } from 'astro:content';

const marcas = (await getCollection('marcas'))
  .filter(m => m.data.activa)
  .sort((a, b) => a.data.orden - b.data.orden);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Mantilhue Alimentos — Más de una década abasteciendo a los negocios que alimentan a Chile">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <img
      src={`${base}images/bodega.jpg`}
      alt="Bodega Mantilhue con pallets listos para despacho"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"></div>
    <div class="relative max-w-7xl mx-auto px-4 py-20 md:py-28 text-center">
      <h1 class="font-heading font-extrabold text-3xl md:text-5xl text-white leading-tight mb-4 drop-shadow-lg">
        Más de una década abasteciendo a los negocios que alimentan a Chile
      </h1>
      <p class="text-gray-100 text-lg md:text-xl max-w-3xl mx-auto mb-8 drop-shadow">
        En Mantilhue producimos, envasamos y distribuimos con infraestructura propia porque sabemos que detrás de cada pedido hay un cliente que confía en que no vas a fallar. Nosotros tampoco fallamos.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${base}catalogo`} class="inline-flex items-center justify-center gap-2 bg-marques text-white px-6 py-3 rounded-lg font-semibold hover:brightness-110 transition shadow-lg">
          Conoce nuestros productos
        </a>
        <a href="https://wa.me/56988074192?text=Hola%2C%20me%20interesa%20cotizar%20productos%20de%20Mantilhue%20Alimentos" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-whatsapp text-white px-6 py-3 rounded-lg font-semibold hover:brightness-110 transition shadow-lg">
          Conversemos por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Qué hacemos -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div>
        <h2 class="font-heading font-bold text-2xl md:text-3xl mb-4">Una trayectoria que se mide en pedidos cumplidos</h2>
        <p class="text-base-muted text-lg mb-4">
          Desde Melipilla llevamos más de diez años haciendo lo mismo cada día: producir con estándar, envasar con control y despachar a tiempo. Esa consistencia es la base sobre la que tu negocio planifica.
        </p>
        <p class="text-base-muted text-lg">
          Operamos con 3.000 m² de bodega propia, líneas de envasado con certificación HACCP y flota propia que cubre de Arica a Chiloé. No dependemos de terceros para responderte, y por eso tú tampoco dependes de terceros para responderle a tu cliente.
        </p>
      </div>
      <div class="rounded-xl overflow-hidden shadow-lg">
        <img
          src={`${base}images/planta-envasado.jpg`}
          alt="Línea de envasado Mantilhue"
          class="w-full h-full object-cover aspect-[4/3]"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Nuestras marcas -->
  <section class="bg-base-surface py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-center mb-3">Tres marcas con historia propia en el mercado chileno</h2>
      <p class="text-base-muted text-center mb-8 max-w-2xl mx-auto">
        El Marqués, El Monarca y Carbón El Valle llevan años construyendo reputación en los estantes. Cada una atiende a un tipo de cliente distinto, todas respaldadas por la misma operación.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {marcas.map((marca) => (
          <BrandCard
            nombre={marca.data.nombre}
            slug={marca.data.slug}
            descripcionCorta={marca.data.descripcionCorta}
            logo={marca.data.logo}
            colorPrimario={marca.data.colorPrimario}
            colorTexto={marca.data.colorTexto}
          />
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={`${base}marcas`} class="text-marques font-semibold hover:underline">Conoce la historia de cada marca →</a>
      </div>
    </div>
  </section>

  <!-- Para quién trabajamos -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-16">
    <h2 class="font-heading font-bold text-2xl md:text-3xl text-center mb-3">Trabajamos con los negocios que sostienen la mesa chilena</h2>
    <p class="text-base-muted text-center mb-8 max-w-2xl mx-auto">
      Distribuidores, minimarkets, restaurantes y comercios en todo Chile confían en Mantilhue para tener siempre lo que sus clientes necesitan. Ese respaldo es el que también te entregamos a ti.
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {[
        { icon: '🏪', label: 'Distribuidores', desc: 'Volumen, continuidad y marcas con rotación comprobada en el mercado.' },
        { icon: '🏬', label: 'Minimarkets', desc: 'Los productos básicos que tu barrio busca todos los días, siempre disponibles.' },
        { icon: '🍽️', label: 'Restaurantes', desc: 'Insumos de calidad constante, lote tras lote, para que tu cocina no cambie.' },
        { icon: '🛒', label: 'Comercios', desc: 'Un portafolio con marcas para cada tipo de cliente que atiendes.' },
      ].map((item) => (
        <div class="bg-base-surface rounded-xl p-6">
          <div class="text-4xl mb-3">{item.icon}</div>
          <p class="font-heading font-semibold text-sm mb-1">{item.label}</p>
          <p class="text-xs text-base-muted">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Diferenciadores -->
  <section class="bg-base-surface py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-center mb-3">La operación detrás de cada pedido cumplido</h2>
      <p class="text-base-muted text-center mb-8 max-w-2xl mx-auto">
        Lo que prometemos, lo tenemos montado. Esta es la infraestructura que respalda cada compromiso que asumimos contigo.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Abastecimiento estable', desc: '3.000 m² de bodega propia en expansión y materias primas desde 11 países. La diversificación que nos permite tener cuando otros no.' },
          { title: 'Marcas con trayectoria', desc: 'El Marqués, El Monarca y Carbón El Valle. Cada una con historia propia y un lugar ganado en los estantes.' },
          { title: 'Flota propia', desc: 'Despachamos de Arica a Chiloé con nuestros camiones. Control total de tiempos, condiciones y compromisos.' },
          { title: 'Trato directo', desc: 'Un equipo comercial que conoce tu negocio y te responde sin intermediarios. Así construimos relaciones que duran.' },
        ].map((item) => (
          <div class="bg-white rounded-xl p-6 border border-base-border">
            <h3 class="font-heading font-semibold text-base mb-2">{item.title}</h3>
            <p class="text-sm text-base-muted">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-16 text-center">
    <h2 class="font-heading font-bold text-2xl md:text-3xl mb-4">Conversemos sobre cómo acompañar a tu negocio</h2>
    <p class="text-base-muted text-lg mb-6">Revisa nuestro catálogo o escríbenos directamente. Te respondemos con transparencia, sin letra chica y con la seriedad que esperas de un proveedor de largo plazo.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={`${base}catalogo`} class="inline-flex items-center justify-center bg-marques text-white px-6 py-3 rounded-lg font-semibold hover:brightness-110 transition">
        Ver catálogo completo
      </a>
      <a href={`${base}contacto`} class="inline-flex items-center justify-center border-2 border-base-text text-base-text px-6 py-3 rounded-lg font-semibold hover:bg-base-text hover:text-white transition">
        Contactar al equipo comercial
      </a>
    </div>
  </section>
</BaseLayout>
