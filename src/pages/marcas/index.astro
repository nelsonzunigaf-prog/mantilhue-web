---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCard from '../../components/BrandCard.astro';
import { getCollection } from 'astro:content';

const marcas = (await getCollection('marcas'))
  .filter(m => m.data.activa)
  .sort((a, b) => a.data.orden - b.data.orden);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Nuestras Marcas — Mantilhue Alimentos"
  description="Conoce las marcas de Mantilhue Alimentos: El Marqués, El Monarca y Carbón El Valle."
>
  <section class="relative overflow-hidden">
    <img
      src={`${base}images/gallery/materia-prima.webp`}
      alt="Materias primas Mantilhue"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/70 to-black/50"></div>
    <div class="relative max-w-7xl mx-auto px-4 py-14 md:py-16">
      <h1 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3 drop-shadow-lg">Tres marcas con historia propia en el mercado chileno</h1>
      <p class="text-gray-100 max-w-3xl drop-shadow">
        El Marqués, El Monarca y Carbón El Valle forman un portafolio construido a lo largo de los años para atender distintos tipos de clientes. Cada una con su identidad, todas respaldadas por la misma trayectoria de cumplimiento Mantilhue.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8 md:py-12">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {marcas.map((marca) => (
        <BrandCard
          nombre={marca.data.nombre}
          slug={marca.data.slug}
          descripcionCorta={marca.data.descripcionCorta}
          logo={marca.data.logo}
          colorPrimario={marca.data.colorPrimario}
          colorTexto={marca.data.colorTexto}
        />
      ))}
    </div>

    <div class="text-center mt-12">
      <a href={`${base}catalogo`} class="inline-flex items-center justify-center bg-marques text-white px-6 py-3 rounded-lg font-semibold hover:brightness-110 transition">
        Ver catálogo general
      </a>
    </div>
  </section>
</BaseLayout>
